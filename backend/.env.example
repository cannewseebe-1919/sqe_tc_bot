# Application
APP_NAME=TC Generator
DEBUG=false

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tc_generator

# Redis (session, queue)
REDIS_URL=redis://localhost:6379/0

# dtgpt (OpenAI compatible LLM API)
DTGPT_BASE_URL=https://dtgpt.example.com/v1
DTGPT_API_KEY=your-api-key-here
DTGPT_MODEL=dtgpt

# Test Executor
EXECUTOR_BASE_URL=http://localhost:8001
EXECUTOR_CALLBACK_URL=http://localhost:8000/api/execution-result

# SAML 2.0 SSO
SAML_SP_ENTITY_ID=tc-generator
SAML_ACS_URL=http://localhost:8000/api/auth/saml/acs
SAML_SLO_URL=http://localhost:8000/api/auth/saml/slo
SAML_IDP_METADATA_URL=https://idp.example.com/metadata

# JWT (service-to-service auth)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000"]
