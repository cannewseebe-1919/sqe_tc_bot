# ================================================================
# sqe_tc_bot 백엔드 환경변수
# 이 파일을 .env 로 복사한 뒤 ★ 표시된 항목을 반드시 수정하세요.
#   cp .env.example .env
# ================================================================

# ── 앱 기본 설정 ─────────────────────────────────────────────────
APP_NAME=TC Generator
DEBUG=false
# DEV_MODE=true 로 설정하면 SAML 인증을 우회합니다 (개발/테스트용)
DEV_MODE=false

# ── 데이터베이스 (PostgreSQL) ─────────────────────────────────────
# Docker Compose 사용 시: @db:5432
# 직접 설치 시: @localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tc_generator  # ★ 비밀번호 변경

# ── Redis ─────────────────────────────────────────────────────────
# Docker Compose 사용 시: redis://redis:6379/0
# 직접 설치 시: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ── dtgpt (사내 LLM API) ──────────────────────────────────────────
# ★ 반드시 사내 dtgpt 서버 주소와 API 키를 입력하세요
DTGPT_BASE_URL=http://dtgpt.internal/v1
DTGPT_API_KEY=your-dtgpt-api-key
DTGPT_MODEL=dtgpt

# ── tc_executor 연동 ──────────────────────────────────────────────
# ★ tc_executor 서버의 실제 주소를 입력하세요
EXECUTOR_BASE_URL=http://executor-server-ip:8001
# ★ tc_bot 서버의 실제 주소를 입력하세요 (executor가 결과를 보낼 주소)
EXECUTOR_CALLBACK_URL=http://tc-bot-server-ip:8000/api/execution-result

# ── SAML 2.0 SSO ─────────────────────────────────────────────────
# ★ 사내 IdP 정보로 변경하세요 (DEV_MODE=true 이면 불필요)
SAML_SP_ENTITY_ID=tc-generator
SAML_ACS_URL=http://tc-bot-server-ip:8000/api/auth/saml/acs
SAML_SLO_URL=http://tc-bot-server-ip:8000/api/auth/saml/slo
SAML_IDP_METADATA_URL=http://idp.internal/metadata
SAML_SETTINGS_PATH=app/core/saml

# ── JWT ───────────────────────────────────────────────────────────
# ★ tc_executor의 JWT_SECRET 과 반드시 동일한 값으로 설정하세요
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────
# ★ 실제 프론트엔드 주소로 변경하세요
CORS_ORIGINS=["http://tc-bot-server-ip:3000"]
